{
  // Hospedagem Girofy enxuta (API, MCP e sites publicados) para uma conta Cloudflare própria.
  // Build: npm run build:standalone. Deploy: npx wrangler deploy -c wrangler.standalone.jsonc
  // Segredo necessário: HOSP_ADMIN_PASSWORD (npx wrangler secret put HOSP_ADMIN_PASSWORD -c wrangler.standalone.jsonc)
  "name": "girofy-hosting",
  "main": "dist-standalone/worker.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "girofy-hosting" }],
  "routes": [{ "pattern": "hosting.girofy.site/*", "zone_name": "girofy.site" }],
  "observability": { "enabled": true }
}
